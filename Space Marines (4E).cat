        <profile name="Crusader Seals" id="751b-0fd3-3e89-9605" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">When a model with crusader seals makes a Consolidate move due to the Righteous Zeal special rule, you may re-roll the D6 when determining the distance moved. You must take the second roll, even if it is worse than the first. If a model with crusader seals is part of a unit then this ability applies to the whole unit, not just the model with the crusader seals.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
