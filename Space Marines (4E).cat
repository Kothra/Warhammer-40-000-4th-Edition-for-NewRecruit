                <repeat childId="terminatorsergeant" field="selections" includeChildSelections="true" repeats="1" roundUp="false" scope="root-entry" shared="true" value="1"/>
                <repeat childId="1507-f6be-3680-5e10" field="selections" includeChildSelections="true" repeats="1" roundUp="false" scope="root-entry" shared="true" value="1"/>
                <repeat childId="bddd-b518-aa98-9fac" field="selections" includeChildSelections="true" repeats="1" roundUp="false" scope="root-entry" shared="true" value="1"/>
                <repeat childId="c171-abee-04ba-97cc" childName="Neophyte" field="selections" includeChildSelections="true" repeats="1" roundUp="false" scope="root-entry" shared="true" value="1"/>
              </repeats>
            </modifier>
            <modifier field="4deb-313d-6685-f48b" type="set" value="10">
              <conditions>
                <condition childId="985e-dda7-9cd9-a782" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditionGroups>
                        <conditionGroup type="or">
