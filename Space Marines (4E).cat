                            <condition childId="8665-850e-0b11-9fec" field="selections" scope="parent" shared="true" type="instanceOf" value="1"/>
                          </conditions>
                        </conditionGroup>
                      </conditionGroups>
                      <conditions>
                        <condition childId="9936-1255-bf77-b8fe" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                      </conditions>
                    </conditionGroup>
