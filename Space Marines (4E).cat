                <repeat childId="ca13-8f18-c026-36c2" field="selections" includeChildSelections="true" repeats="1" roundUp="false" scope="root-entry" shared="true" value="1"/>
                <repeat childId="3b51-2480-5a6f-3d60" field="selections" includeChildSelections="true" repeats="1" roundUp="false" scope="root-entry" shared="true" value="1"/>
