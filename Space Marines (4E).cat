          </constraints>
          <selectionEntries>
            <selectionEntry name="Storm of the Emperor&apos;s Wrath" id="deac-1756-e112-bc43" defaultAmount="1" hidden="false" import="true" sortIndex="1" type="upgrade">
              <constraints>
                <constraint id="1fbf-cb38-0082-a50b" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="6eb2-11db-1c7c-ad91" automatic="true" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="0"/>
              </constraints>
              <modifiers>
                <modifier field="6eb2-11db-1c7c-ad91" type="set" value="1">
                  <conditions>
                    <condition childId="d018-499a-2d02-483e" field="selections" scope="parent" shared="true" type="instanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Storm of the Emperor&apos;s Wrath" id="55dc-5993-a426-a130" hidden="false" typeId="9c33-b0c8-74bd-e5a7" typeName="Psychic Power (Attack)">
                  <characteristics>
                    <characteristic name="Range" typeId="5bf6-378a-0cb7-b079">12&quot;</characteristic>
                    <characteristic name="Strength" typeId="12da-9b3e-f37b-bc35">4</characteristic>
                    <characteristic name="AP" typeId="10b5-aa5b-ccde-79cc">2</characteristic>
                    <characteristic name="Type" typeId="20e7-cbcb-1781-a732">Assault 1, Blast</characteristic>
                    <characteristic name="Details" typeId="a812-390d-dff6-dabd">This psychic power is used in the Shooting phase instead of firing a weapon.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Fury of the Ancients" id="c672-6a62-b00d-52de" hidden="false" import="true" sortIndex="2" type="upgrade">
              <constraints>
                <constraint id="70e1-9b0d-0eec-55a5" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="3"/>
              </costs>
              <modifiers>
                <modifier field="4deb-313d-6685-f48b" type="set" value="0">
                  <conditions>
                    <condition childId="d2fd-1e19-346c-e5f5" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Fury of the Ancients" id="fc40-2a61-43e9-d2a4" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">This psychic power is used in the Shooting phase instead of firing a weapon. The Librarian summons a psychic construct that moves in a straight line from the Librarian to any point on any table edge. Every unit in its path will suffer D3 Strength 5, AP - hits and must take a Pinning test. If the construct would hit a friendly unit or a unit Locked in close combat it will dissipate just before impact and has no further effect.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Fear of the Darkness" id="b8c9-abcf-e406-1379" hidden="false" import="true" sortIndex="3" type="upgrade">
              <constraints>
                <constraint id="2595-ea6d-17ec-29ba" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="5"/>
              </costs>
              <modifiers>
                <modifier field="4deb-313d-6685-f48b" type="set" value="0">
                  <conditions>
                    <condition childId="d2fd-1e19-346c-e5f5" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Fear of the Darkness" id="7059-46fd-8df6-e4ae" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">This psychic power is used in the Shooting phase instead of firing a weapon. Every enemy unit within 12&quot; of the Librarian not Locked in close combat must take a Morale check (as though they had taken 25% casualties) with a -2 modifier to their Leadership, or fall back. All normal conditions and/or exceptions apply (ie, units that never fall back are immune to this power).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Might of Heroes" id="0ee6-ac3e-31e9-7eef" hidden="false" import="true" sortIndex="4" type="upgrade">
              <constraints>
                <constraint id="4d8a-d656-5347-3a41" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="5"/>
              </costs>
              <modifiers>
                <modifier field="4deb-313d-6685-f48b" type="set" value="0">
                  <conditions>
                    <condition childId="d2fd-1e19-346c-e5f5" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Might of Heroes" id="6489-2845-476f-2fb2" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">This psychic power is used at the start of either player&apos;s Assault phase. The Librarian (or one model in the same unit as the Librarian) gains D3+ attacks in that Assault phase.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Veil of Time" id="d72c-84df-c6d7-85bd" hidden="false" import="true" sortIndex="5" type="upgrade">
              <constraints>
                <constraint id="2d6e-0c54-fdef-92d9" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="10"/>
              </costs>
              <modifiers>
                <modifier field="4deb-313d-6685-f48b" type="set" value="0">
                  <conditions>
                    <condition childId="d2fd-1e19-346c-e5f5" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Veil of Time" id="2a92-268b-79ce-d131" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">This psychic power is used at the start of the Movement phase and lasts until the end of the Space Marine turn. In that time the Librarian can choose to re-roll any rolls to hit, rolls to wound, Armour Saves, Invulnerable Saves, Leadership tests or Morale checks. Note that the re-rolled result must be accepted.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Vortex of Doom" id="f872-d11e-083b-d9ee" hidden="false" import="true" sortIndex="6" type="upgrade">
              <constraints>
                <constraint id="ee47-d2df-ba41-82cc" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="10"/>
              </costs>
              <modifiers>
                <modifier field="4deb-313d-6685-f48b" type="set" value="0">
                  <conditions>
                    <condition childId="d2fd-1e19-346c-e5f5" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Vortex of Doom" id="1da1-7add-42e3-afb5" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">This psychic power is used in the Shooting phase instead of firing a weapon. Place a small Blast marker over any enemy unit not Locked in combat within 12&quot; of the Librarian. Once you have placed the Blast marker, roll the Scatter dice - on a Hit, a rift opens beneath the Blast marker, otherwise move the Blast marker D6&quot; in the direction of the arrow. This power has no effect on vehicles or monstrous creatures, as they are too large to be pulled into the Warp rift. Enemy models fully covered by the marker must roll equal or under their Initiative characteristic on a D6 or they will be sucked into the depths of the Warp and destroyed instantly, without recourse to a Saving throw of any kind. Note that a roll of 6 is always a failure, regardless of the target&apos;s Initiative characteristic. Models only partially beneath the marker will only be affected on a D6 roll of 4+.


If when using this power the Librarian rolls a 12 on his Psychic test, resolve the Peris of the Warp attack on the Librarian normally, then, if he survives, place the Vortex of Doom Blast marker on the Librarian and then resolve the effects of the power.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntryGroup>
