    <selectionEntry name="Drop Pod" id="fa50-c2b5-c7cf-865e" hidden="false" import="true" publicationId="e1e7-bf54-15e0-5ded" type="unit">
      <constraints>
        <constraint id="9cbc-70b5-9944-7780" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
