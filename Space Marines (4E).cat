      </entryLinks>
      <modifiers>
        <modifier field="6050-a68e-8ddb-4f3d" type="set" value="1">
          <conditionGroups>
            <conditionGroup type="or">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="0d45-9523-cfd8-4efd" childName="HQ" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="1"/>
                    <condition childId="c42e-cf0a-8159-2e39" childName="Damocles Command Rhino [FW]" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0"/>
