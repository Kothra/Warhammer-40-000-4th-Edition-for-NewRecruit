                </conditionGroup>
              </conditionGroups>
              <conditions>
                <condition childId="0d45-9523-cfd8-4efd" childName="HQ" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="2"/>
              </conditions>
