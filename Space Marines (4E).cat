            <conditionGroup type="and">
              <conditions>
                <condition childId="9862-c761-5bd2-ffc7" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                <condition childId="6673-2bce-9ffb-26cf" childName="Commander" field="selections" scope="parent" shared="true" type="instanceOf" value="1"/>
                <condition childId="9a66-b0e3-9de5-db79" childName="Master" field="selections" includeChildSelections="true" scope="parent" shared="true" type="atLeast" value="1"/>
              </conditions>
