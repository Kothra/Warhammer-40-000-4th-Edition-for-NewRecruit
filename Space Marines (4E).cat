                        </conditionGroup>
                      </conditionGroups>
                      <conditions>
                        <condition childId="fdf9-1cfb-b098-dd8e" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0"/>
                      </conditions>
                    </conditionGroup>
                    <conditionGroup type="and">
                      <conditions>
                        <condition childId="25a6-2980-b55b-0b6f" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0"/>
                        <condition childId="fdf9-1cfb-b098-dd8e" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0"/>
                        <condition childId="1841-812c-ce41-981f" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                        <condition childId="39ab-2bcd-49d1-cfef" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
