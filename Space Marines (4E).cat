              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
      </modifiers>
      <selectionEntries>
        <selectionEntry name="Furious Charge" id="e09a-e012-7917-e86c" hidden="false" import="true" sortIndex="1" type="upgrade">
          <constraints>
            <constraint id="e0f5-0989-520c-4f51" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <infoLinks>
            <infoLink name="Furious Charge" id="8094-7e5e-7be8-244f" hidden="false" targetId="d9b8-5d21-f44f-80d3" type="rule"/>
          </infoLinks>
          <modifiers>
            <modifier field="4deb-313d-6685-f48b" type="increment" value="3">
