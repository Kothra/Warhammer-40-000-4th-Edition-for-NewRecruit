    <selectionEntry name="Be Swift as the Wind" id="45de-058b-6030-eb48" hidden="false" import="false" type="upgrade">
      <constraints>
        <constraint id="3148-5218-4368-058c" automatic="true" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
      </constraints>
      <modifiers>
        <modifier field="3148-5218-4368-058c" type="set" value="0">
          <conditions>
            <condition childId="2607-0199-232f-a932" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Be Swift as the Wind" id="02f9-b333-a730-3d35" hidden="false">
          <description>May take Bike Squadrons as Elites or as Troops.
Any taken as Elites must select either the Tank Hunter or Furious Charge skill at a cost of +3 points per model.
Any taken as Troops must be at least 5 models strong.
Any Bike Squadron may take the Expert Rider special rule at +2 points per model.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Blessed be the Warriors" id="25a6-2980-b55b-0b6f" hidden="false" import="false" type="upgrade">
