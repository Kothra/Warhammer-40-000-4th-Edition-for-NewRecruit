            <selectionEntry name="Death Mask" id="7788-cf1a-c4a3-3e02" hidden="true" import="true" type="upgrade">
              <constraints>
                <constraint id="ca6c-1051-eef4-130c" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
