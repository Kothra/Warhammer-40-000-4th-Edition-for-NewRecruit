        <profile name="Warbike" id="79d8-097b-471c-dc79" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Any model mounted on a Warbike ads 1 to his Toughnes (though not for determining Instant Death), modifies his troop type to Bike, gains a 4+ Armour Save and the Exhaust Cloud special rule. Warbikes have twin-linked dakkaguns mounted.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Exhaust Cloud" id="c186-8a11-f3a3-a9ba" hidden="false">
          <description>Warbikers produce great clouds of smoky exhaust fumes, giving them a 4+ Cover Save.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Twin-linked Dakkagun" id="34f8-41e2-c87e-ff5f" hidden="false" import="true" type="upgrade">
