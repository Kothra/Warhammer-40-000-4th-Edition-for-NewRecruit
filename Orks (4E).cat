          <profiles>
            <profile name="Squig Hound" id="40c3-2085-1cee-0281" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
              <characteristics>
                <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Each time a unit with a squig-hound fails a Morale test it may remove D3 Gretchin models to re-roll that Morale test.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
      <selectionEntryGroups>
        <selectionEntryGroup name="Tools" id="6eef-fc76-8957-53e7" defaultSelectionEntryId="16b7-b4d4-0e0c-591a" flatten="true" hidden="false" sortIndex="1">
