              <characteristics>
                <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">When Ghazghkull charges, he gets +2 Attacks instead of the usual +1. In addition, Ghazghkull is immune to Instant Death.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
