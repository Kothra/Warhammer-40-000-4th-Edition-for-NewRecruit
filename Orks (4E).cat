    <selectionEntry name="Bosspole" id="7a28-d1f1-d3f6-dd6c" hidden="false" import="true" type="upgrade">
      <profiles>
        <profile name="Bosspole" id="bbd6-df4d-2e84-0f49" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Each time a unit with a Bosspole fails a Morale test you may chose to inflict a wound on that unit (not on the model with the Bosspole) in order to re-roll that Morale test.</characteristic>
          </characteristics>
        </profile>
      </profiles>
