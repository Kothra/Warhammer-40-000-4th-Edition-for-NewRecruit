          </constraints>
          <selectionEntries>
            <selectionEntry name="Grabba Stikk" id="16b7-b4d4-0e0c-591a" hidden="false" import="true" sortIndex="1" type="upgrade">
              <profiles>
                <profile name="Grabba Stikk" id="2696-978f-7452-2803" hidden="false" typeId="b729-49a4-4123-cf00" typeName="Melee Weapon">
                  <characteristics>
                    <characteristic name="Details" typeId="acf3-d214-6e51-29fe">A model with a grabba stikk attacks normally but each Assault phase he can cause a single model in base contact to lose an Attack (to a minimum of 1).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Grot-prod" id="6b30-2acb-3611-8383" hidden="false" import="true" sortIndex="2" type="upgrade">
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="5"/>
              </costs>
              <profiles>
                <profile name="Grot-prod" id="8e90-5122-3eaf-be79" hidden="false" typeId="b729-49a4-4123-cf00" typeName="Melee Weapon">
                  <characteristics>
                    <characteristic name="Details" typeId="acf3-d214-6e51-29fe">A model with a grot-prod counts as having a Poisoned Weapon that always wounds on 4+.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
