                <entryLink name="Choppa" id="ac17-54ee-809e-ee47" hidden="false" import="true" sortIndex="3" targetId="3a1b-0ace-cfc6-27ff" type="selectionEntry">
                  <constraints>
                    <constraint id="36af-e601-9ed2-0bb4-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
                    <constraint id="36af-e601-9ed2-0bb4-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditions>
                        <condition childId="5bd4-2440-a1f8-200b" childName="Special Weapons" field="selections" scope="parent" shared="true" type="atLeast" value="1"/>
                      </conditions>
