          <selectionEntries>
            <selectionEntry name="Bigbomm" id="66cd-a4cd-c9e1-6359" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="9f82-9a53-3064-a71f" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
