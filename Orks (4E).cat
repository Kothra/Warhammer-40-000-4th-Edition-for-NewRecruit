    <selectionEntry name="Ammo Runt" id="36b0-62a1-c139-b975" hidden="false" import="true" type="upgrade">
      <profiles>
        <profile name="Ammo Runt" id="5c98-6de0-fe93-090a" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">A model with an ammo runt is allowed to re-roll one to hit roll for a shooting attack, once per game.

Ammo runt models are purely decorative and are always ignored for game purposes. Just move them to one side if they become a problem.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
