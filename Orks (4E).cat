                  </modifiers>
                </entryLink>
              </entryLinks>
              <profiles>
                <profile name="Bozz Zagstruk" id="a8f4-fe46-d334-84fe" hidden="false" typeId="556e697423232344415441232323" typeName="Unit">
                  <characteristics>
                    <characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Jump Infantry</characteristic>
                    <characteristic name="WS" typeId="5.753232323444154e+23">5</characteristic>
                    <characteristic name="BS" typeId="4.2532323234441546e+23">2</characteristic>
                    <characteristic name="S" typeId="5.323232344415441e+21">4</characteristic>
                    <characteristic name="T" typeId="5.423232344415441e+21">4</characteristic>
                    <characteristic name="W" typeId="5.723232344415441e+21">2</characteristic>
                    <characteristic name="I" typeId="4.923232344415441e+21">3</characteristic>
                    <characteristic name="A" typeId="4.123232344415441e+21">4</characteristic>
                    <characteristic name="LD" typeId="4c4423232344415441232323">9</characteristic>
                    <characteristic name="Sv" typeId="5.361766523232344e+27">4+</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Swoop Attack" id="7ef9-4aea-9a93-0ef3" hidden="false">
                  <description>Zagstruk and da Vulcha Boyz must enter the battle via Deep Strike. They may not shoot that turn, but to represent their swooping dive into the enemy rank they may assault that turn (provided they are close enough). If the Vulcha Squad assaults the turn it Deep Strikes into play, remove D3 Stormboyz at the beginning of combat as crash landing casualties.</description>
                </rule>
                <rule name="Violent Temper" id="b16a-54e6-2dd7-48f7" hidden="false">
                  <description>Should his unit ever fail a Morale check, Zagstruk will execute a member of the unit to restore order. The unit is instead counted as passing the test, but a Stormboy model must be removed as a casualty as a result. If Zagstruk is on his own, the Violent Temper rule does not apply.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry name="Rokkit Pack" id="dbfc-241e-91d8-9ded" hidden="false" import="true" sortIndex="6" type="upgrade">
                  <constraints>
                    <constraint id="1cb9-46eb-f49d-ce38-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
                    <constraint id="1cb9-46eb-f49d-ce38-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <profiles>
                    <profile name="Rokkit Pack" id="4a43-4ee7-eb01-9699" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
                      <characteristics>
                        <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Rokkit packs count as jump packs. Every time the Stormboyz unit utilises its rokkit packs to move or fall back, roll a D6. On a roll of 1, one of the rokkit packs has gone out of control and explodes. Remove a Stormboy model as a casualty. Regardless of the result you may add the number rolls to the amount the unit moves that turn.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Da Vulcha&apos;s Klaws" id="0841-ed99-13f4-ccf9" hidden="false" import="true" sortIndex="1" type="upgrade">
                  <constraints>
                    <constraint id="6691-78af-f715-01dd-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
                    <constraint id="6691-78af-f715-01dd-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <profiles>
                    <profile name="Da Vulcha&apos;s Klaws" id="b13f-9424-2d53-09eb" hidden="false" typeId="b729-49a4-4123-cf00" typeName="Melee Weapon">
                      <characteristics>
                        <characteristic name="Details" typeId="acf3-d214-6e51-29fe">On any turn that Zagstruk charges, he counts as having a power klaw that strikes in normal Initiative order (remember that with Zagstruk&apos;s Furious Charge this will be resolved at Initiative 4).</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
